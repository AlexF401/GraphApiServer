# Microsoft Entra app registration
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000

# How the service signs in to Microsoft Graph:
#   delegated   - (default) sign in once as the sending mailbox with:
#                 docker compose exec graphapiserver python -m app.signin
#                 Needs delegated Mail.Send and "Allow public client flows" = Yes. No secret.
#   application - app-only: needs application Mail.Send (admin consent), CLIENT_SECRET and SENDER_ADDRESS.
AUTH_MODE=delegated

# Application mode only (leave empty for delegated)
CLIENT_SECRET=
SENDER_ADDRESS=

# One key per calling app, as name:key pairs separated by commas
API_KEYS=billing:replace-with-long-random-key,crm:another-long-random-key

# Optional
SAVE_TO_SENT_ITEMS=false
MAX_ATTACHMENT_BYTES=3145728

# Queue (optional)
MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=30
RETRY_MAX_SECONDS=1800
SEND_INTERVAL_SECONDS=0.5
