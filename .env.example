# Entra / Azure app registration (application permission Mail.Send, admin-consented)
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=change-me

# Mailbox every email is sent from
SENDER_ADDRESS=noreply@example.com

# One key per calling app, as name:key pairs separated by commas
API_KEYS=billing:replace-with-long-random-key,crm:another-long-random-key

# Optional
SAVE_TO_SENT_ITEMS=false
MAX_ATTACHMENT_BYTES=3145728
